# Container-only install manifest.
# Host: pyproject.toml is the Hatch package (Python nodes/models only; no Fortran).
# Image: Dockerfile copies this to pyproject.toml, then `uv pip install .`.
# FCclasses3 / fcc_tools binaries are built in the Dockerfile with gfortran.
[project]
name = "molecular_qm_fcctools"
version = "0.1.0"
description = "fcc_tools (FCclasses input generation / post-processing) for molecular quantum mechanics within the Simstack framework"
readme = "README.md"
requires-python = ">=3.12"
license = { text = "MIT" }
authors = [
  { name = "Wolfgang Wenzel", email = "wolfgang.wenzel@kit.edu" }
]
dependencies = [
    "molecular_qm_models",
    "molecular_qm_util",
    "molecular_qm_gaussian",
    "simstack",
    "numpy",
    "scipy",
]

[project.entry-points."simstack.modules"]
molecular_qm_fcctools = "molecular_qm_fcctools"

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[tool.hatch.metadata]
allow-direct-references = true

[tool.uv.sources]
molecular_qm_models = { git = "https://github.com/simstack/molecular_qm_models.git" }
molecular_qm_util = { git = "https://github.com/simstack/molecular_qm_util.git" }
molecular_qm_gaussian = { git = "https://github.com/simstack/molecular_qm_gaussian.git" }
simstack = { git = "https://github.com/simstack/simstack.git", rev = "ww/new-features" }

[tool.uv]
override-dependencies = [
    "molecular_qm_models @ git+https://github.com/simstack/molecular_qm_models.git",
    "molecular_qm_util @ git+https://github.com/simstack/molecular_qm_util.git",
    "simstack @ git+https://github.com/simstack/simstack.git@ww/new-features",
]
